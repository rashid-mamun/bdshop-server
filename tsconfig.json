{
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "types": ["node"],
        "incremental": true
    },
    "ts-node": {
        "transpileOnly": false,
        "compilerOptions": {
            "module": "Node16"
        }
    },
    "include": ["src/**/*", "server.ts"],
    "exclude": ["node_modules", "dist", "tests"]
}
