{
  "name": "bdshop-server",
  "version": "2.1.0",
  "description": "A comprehensive e-commerce API server with improved security, validation, and testing using functional programming patterns",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start-dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration/",
    "test:integration:health": "jest tests/integration/health.test.js",
    "test:integration:users": "jest tests/integration/users.test.js",
    "test:integration:services": "jest tests/integration/services.test.js",
    "test:integration:orders": "jest tests/integration/orders.test.js",
    "test:integration:carts": "jest tests/integration/carts.test.js",
    "test:integration:reviews": "jest tests/integration/reviews.test.js",
    "test:integration:public": "jest tests/integration/public.test.js",
    "test:integration:endpoints": "jest tests/integration/endpoints.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "clean": "rm -rf logs/* coverage/*",
    "setup": "npm install && npm run lint:fix && npm run format"
  },
  "keywords": [
    "ecommerce",
    "api",
    "mongodb",
    "express",
    "nodejs",
    "rest-api",
    "functional-programming",
    "testing",
    "integration-tests"
  ],
  "author": "rashid-mamun",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "express-rate-limit": "^7.1.5",
    "express-winston": "^4.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^4.5.0",
    "mongoose": "^6.5.2",
    "morgan": "^1.10.0",
    "winston": "^3.8.1"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!tests/**",
      "!coverage/**",
      "!test_*.js",
      "!test_server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}