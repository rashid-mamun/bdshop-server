{
    "name": "bdshop-server",
    "version": "2.1.0",
    "description": "A comprehensive e-commerce API server with improved security, validation, and testing using functional programming patterns",
    "main": "server.ts",
    "scripts": {
        "start": "ts-node server.ts",
        "dev": "nodemon --watch src --watch server.ts --ext ts,json --exec ts-node server.ts",
        "start-dev": "ts-node-dev --respawn --transpile-only server.ts",
        "build": "tsc",
        "test": "jest --detectOpenHandles --forceExit",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:integration": "jest tests/integration/",
        "test:integration:health": "jest tests/integration/health.test.js",
        "test:integration:users": "jest tests/integration/users.test.js",
        "test:integration:services": "jest tests/integration/services.test.js",
        "test:integration:orders": "jest tests/integration/orders.test.js",
        "test:integration:carts": "jest tests/integration/carts.test.js",
        "test:integration:reviews": "jest tests/integration/reviews.test.js",
        "test:integration:public": "jest tests/integration/public.test.js",
        "test:integration:addresses": "jest tests/integration/addresses.test.js",
        "test:integration:auth": "jest tests/integration/auth.test.js",
        "test:integration:upload": "jest tests/integration/upload.test.js",
        "test:integration:endpoints": "jest tests/integration/endpoints.test.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "clean": "node -e \"const fs=require('fs'); for (const dir of ['logs','coverage']) fs.rmSync(dir,{recursive:true,force:true});\"",
        "setup": "npm install && npm run lint:fix && npm run format",
        "seed": "ts-node src/seed.ts",
        "seed:fresh": "ts-node src/seed.ts --fresh"
    },
    "keywords": [
        "ecommerce",
        "api",
        "mongodb",
        "express",
        "nodejs",
        "rest-api",
        "functional-programming",
        "testing",
        "integration-tests"
    ],
    "author": "rashid-mamun",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.6.0",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.10.0",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.0.0",
        "express": "^4.17.3",
        "express-rate-limit": "^7.1.5",
        "express-winston": "^4.2.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^4.5.0",
        "mongoose": "^6.5.2",
        "morgan": "^1.10.0",
        "multer": "^2.1.1",
        "stripe": "^22.1.1",
        "winston": "^3.8.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose": "^5.11.96",
        "@types/multer": "^2.1.0",
        "@types/morgan": "^1.9.9",
        "@types/compression": "^1.7.5",
        "@types/node": "^25.6.2",
        "@typescript-eslint/eslint-plugin": "^8.59.2",
        "@typescript-eslint/parser": "^8.59.2",
        "cookie-parser": "^1.4.7",
        "eslint": "^8.57.1",
        "jest": "^29.7.0",
        "mongodb-memory-server": "^10.1.4",
        "nodemon": "^3.0.1",
        "prettier": "^3.8.3",
        "supertest": "^6.3.3",
        "ts-jest": "^29.2.6",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.3"
    },
    "jest": {
        "testEnvironment": "node",
        "testTimeout": 15000,
        "transform": {
            "^.+\\.(ts|tsx)$": "ts-jest"
        },
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "json"
        ],
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!node_modules/**",
            "!tests/**",
            "!coverage/**",
            "!test_*.js",
            "!test_server.js"
        ],
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/tests/setup.js"
        ],
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    }
}
